# docker compose reads this file. Copy to .env and change every value that is a key or a password.
ALLDASH_ENVIRONMENT=local
ALLDASH_API_KEYS=dev-key-change-me
# Login for the Next.js workspace (HTTP Basic). Change both.
FRONTEND_AUTH_USER=admin
FRONTEND_AUTH_PASSWORD=dev-password-change-me
ALLDASH_TIMEZONE=UTC
ALLDASH_DAILY_BRIEF_HOUR=4
ALLDASH_LOG_LEVEL=INFO
POSTGRES_USER=alldash
POSTGRES_PASSWORD=alldash
POSTGRES_DB=alldash
